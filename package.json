{
  "name": "local-password-manager",
  "private": true,
  "version": "0.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vue-tsc --noEmit --noUnusedLocals --noUnusedParameters && vite build",
    "tauri": "node scripts/tauri.mjs",
    "desktop:dev": "node scripts/tauri.mjs dev",
    "desktop:build": "node scripts/tauri.mjs build --no-bundle",
    "package:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-installer.ps1",
    "verify:release": "node scripts/verify-package.mjs",
    "verify:integration": "node scripts/verify-next.mjs",
    "verify:permissions": "node scripts/verify-permissions.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "format": "prettier --write frontend tests/support/frontend",
    "format:check": "prettier --check frontend tests/support/frontend",
    "verify:regression": "node scripts/verify-regression.mjs",
    "build:test": "vue-tsc --noEmit --noUnusedLocals --noUnusedParameters && vite build --mode test",
    "desktop:test": "node scripts/build-test.mjs",
    "verify:prepush": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tauri-apps/cli": "2.12.3",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0"
}
